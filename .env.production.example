# ===========================================
# GL_JB Production Environment Template
# ===========================================
# Скопируйте в .env и заполните реальными значениями
# cp .env.production.example .env
# ===========================================

# Flask
SECRET_KEY=сгенерируйте_через_openssl_rand_hex_32
FLASK_ENV=production
FLASK_DEBUG=0

# Admin (ОБЯЗАТЕЛЬНО)
ADMIN_PASSWORD=сильный_пароль_админа_минимум_16_символов
ADMIN_TOKEN=ABC12  # 5 символов A-Z, 0-9 для суперадмина

# ===========================================
# Database (PostgreSQL для продакшена)
# ===========================================
# Docker Compose подставит POSTGRES_PASSWORD автоматически
POSTGRES_PASSWORD=сильный_пароль_базы_данных
DATABASE_URL=postgresql://gl_jb_user:${POSTGRES_PASSWORD}@postgres:5432/gl_jb

# Для локальной разработки без Docker:
# DATABASE_URL=sqlite:///database.db

# ===========================================
# Uploads
# ===========================================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB

# ===========================================
# Rate Limiting (Redis для продакшена)
# ===========================================
RATELIMIT_STORAGE_URL=redis://redis:6379/0

# Для разработки:
# RATELIMIT_STORAGE_URL=memory://

# ===========================================
# Celery (Redis broker + backend)
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ===========================================
# Email (настроено для mail.ru SSL 465)
# Раскомментируйте и заполните для включения уведомлений
# ===========================================
# MAIL_SERVER=smtp.mail.ru
# MAIL_PORT=465
# MAIL_USE_TLS=0
# MAIL_USE_SSL=1
# MAIL_USERNAME=ваш_email@mail.ru
# MAIL_PASSWORD=пароль_приложения_или_обычный_пароль
# MAIL_DEFAULT_SENDER=ваш_email@mail.ru
# MAIL_ADMIN_RECIPIENTS=admin1@domain.com,admin2@domain.com

# Для Gmail:
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USE_SSL=1
# MAIL_USERNAME=ваш@gmail.com
# MAIL_PASSWORD=app_password_16_символов

# Для Яндекс:
# MAIL_SERVER=smtp.yandex.ru
# MAIL_PORT=465
# MAIL_USE_SSL=1

# ===========================================
# Security (Talisman)
# ===========================================
# Force HTTPS в продакшене (Talisman включит автоматически при FLASK_DEBUG=0)
# Для работы за reverse proxy (nginx):
# PREFERRED_URL_SCHEME=https

# ===========================================
# Logging
# ===========================================
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log

# ===========================================
# Docker / Deployment
# ===========================================
# Для Render / Railway / Fly.io:
# RENDER_SERVICE_ID=ваш_service_id

# Для кэширования статики:
# SEND_FILE_MAX_AGE_DEFAULT=31536000  # 1 год