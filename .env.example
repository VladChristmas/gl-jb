# Flask
SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Admin
# ADMIN_PASSWORD=ВАШ_СЛОЖНЫЙ_ПАРОЛЬ_ЗДЕСЬ  # ОБЯЗАТЕЛЬНО раскомментируйте и задайте!
ADMIN_TOKEN=VSE5H

# Database
DATABASE_URL=sqlite:///database.db

# Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Rate limiting
RATELIMIT_STORAGE_URL=memory://

# Email (настроено для mail.ru — SSL на порту 465)
# Раскомментируйте и заполните для включения уведомлений:
# MAIL_SERVER=smtp.mail.ru
# MAIL_PORT=465
# MAIL_USE_TLS=0
# MAIL_USE_SSL=1
# MAIL_USERNAME=ваш_email@mail.ru
# MAIL_PASSWORD=ваш_пароль_от_почты_mail_ru
# MAIL_DEFAULT_SENDER=ваш_email@mail.ru
# MAIL_ADMIN_RECIPIENTS=ваш_email@mail.ru,другой@mail.ru